class CLIError(Exception):
    pass


_USE_COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
_PALETTE = {
    "reset": "\033[0m",
    "bold": "\033[1m",
    "red": "\033[31m",
    "green": "\033[32m",
    "yellow": "\033[33m",
    "blue": "\033[34m",
    "cyan": "\033[36m",
    "gray": "\033[90m",
}


def paint(text: str, color: str = "") -> str:
    if not _USE_COLOR or not color:
        return text
    return f"{_PALETTE.get(color, '')}{text}{_PALETTE['reset']}"


def clear_screen() -> None:
    if _USE_COLOR:
        sys.stdout.write("\033[2J\033[H")


_ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
_MENU_INNER = 54
MENU_TOP = "  ╔" + "═" * (_MENU_INNER + 2) + "╗"
MENU_SEP = "  ╠" + "═" * (_MENU_INNER + 2) + "╣"
MENU_BOTTOM = "  ╚" + "═" * (_MENU_INNER + 2) + "╝"


def menu_row(content: str = "") -> str:
    """Box row; content may already contain ANSI colors."""
    visible = len(_ANSI_RE.sub("", content))
    return "  ║ " + content + " " * max(0, _MENU_INNER - visible) + " ║"


def badge(text: str, good: bool, *, bad_color: str = "yellow") -> str:
    return paint(f"[ {text} ]", "green" if good else bad_color)


def log(message: str) -> None:
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"[{stamp}] {message}", flush=True)


def run(command: list[str], *, check: bool = True, capture: bool = False, cwd: str | None = None) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(command, text=True, capture_output=capture, cwd=cwd)
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip()
        raise CLIError(f"команда завершилась с кодом {result.returncode}: {' '.join(command)}\n{detail}")
    return result


def require_root() -> None:
    if os.geteuid() != 0:
        raise CLIError("команда требует прав root: sudo zapret-flowseal <команда>")


def config_path(cfg: dict) -> Path:
    return Path(os.environ.get("ZAPRET_FLOWSEAL_CONFIG", str(Path(cfg["config_dir"]) / "config.json")))


def state_path(cfg: dict) -> Path:
    return Path(cfg["work_dir"]) / "state.json"


def load_config() -> dict:
    path = Path(os.environ.get("ZAPRET_FLOWSEAL_CONFIG", "/etc/zapret-flowseal/config.json"))
    cfg = dict(DEFAULT_CONFIG)
    if path.exists():
        try:
            cfg.update(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError) as exc:
            raise CLIError(f"не удалось прочитать конфиг {path}: {exc}") from exc
    return cfg


def save_config(cfg: dict) -> None:
    path = config_path(cfg)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)


def load_state(cfg: dict) -> dict:
    path = state_path(cfg)
    if not path.exists():
        return {}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}


def save_state(cfg: dict, state: dict) -> None:
    path = state_path(cfg)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")


def lock(cfg: dict):
    path = Path(cfg["work_dir"]) / "update.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    handle = path.open("a+")
    fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    return handle


def move_aside_if_foreign(path: Path) -> Path | None:
    """Rename a non-empty directory that is not a git repo, keeping its data."""
    if path.exists() and not (path / ".git").exists() and any(path.iterdir()):
        backup = path.parent / f"{path.name}.backup-{datetime.now().strftime('%Y%m%d-%H%M%S')}"
        log(f"каталог {path} непуст и не является репозиторием — перемещаю в {backup}")
        path.rename(backup)
        return backup
    return None


def dirs(cfg: dict) -> dict[str, Path]:
    work = Path(cfg["work_dir"])
    engine = Path(cfg["engine_dir"])
    return {
        "work": work,
        "upstream": work / "upstream",
        "assets": work / "assets",
        "lists": work / "assets" / "lists",
        "generated": work / "generated",
        "tool": work / "tool",
        "engine": engine,
        "engine_lua": engine / "lua",
        "engine_bin": engine / "bin",
        "init": engine / "init.d" / "sysv" / "zapret2",
        "pidfile": Path("/var/run/nfqws2_1.pid"),
    }


def git(repo: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return run(["git", "-C", str(repo), *args], check=check, capture=True)


def is_installed(cfg: dict) -> bool:
    d = dirs(cfg)
    return (d["upstream"] / ".git").exists() and (d["engine"] / "init.d/sysv/zapret2").exists()


def assert_installed(cfg: dict) -> dict[str, Path]:
    d = dirs(cfg)
    if not is_installed(cfg):
        raise CLIError("не установлено. Выполните: sudo bash install-here.sh")
    return d


def strategies(d: dict[str, Path]) -> list[str]:
    return sorted((path.stem for path in d["upstream"].glob("general*.bat")), key=str.lower)


def game_values(cfg: dict) -> tuple[str, str]:
    mode = cfg.get("game_filter", "off")
    # Flowseal uses port 12 as an inert placeholder when the filter is off.
    tcp = cfg["game_filter_tcp"] if mode in ("all", "tcp") else "12"
    udp = cfg["game_filter_udp"] if mode in ("all", "udp") else "12"
    return tcp, udp


def firewall_ports(cfg: dict) -> tuple[str, str]:
    mode = cfg.get("game_filter", "off")
    tcp = BASE_TCP_PORTS
    udp = BASE_UDP_PORTS
    if mode in ("all", "tcp"):
        tcp += "," + cfg["game_filter_tcp"]
    if mode in ("all", "udp"):
        udp += "," + cfg["game_filter_udp"]
    return tcp, udp


def build_args(cfg: dict, d: dict[str, Path], name: str | None = None, *, for_engine: bool = True) -> ConvertedStrategy:
    name = name or cfg["strategy"]
    path = d["upstream"] / f"{name}.bat"
    if not path.exists():
        raise CLIError(f"неизвестная стратегия: {name}")
    lua_dir = d["engine_lua"] if for_engine else d["assets"] / "lua"
    tcp, udp = game_values(cfg)
    return convert_strategy(
        path,
        lua_dir=str(lua_dir),
        lists_dir=str(d["lists"]),
        bin_dir=str(d["engine_bin"]),
        engine_dir=str(d["engine"]) if for_engine else str(d["work"]),
        game_tcp=tcp,
        game_udp=udp,
    )


def detect_engine_version(upstream: Path) -> str | None:
    binary = upstream / "bin" / "winws2.exe"
    if not binary.exists():
        return None
    if shutil.which("strings"):
        output = run(["strings", str(binary)], capture=True, check=False).stdout
    else:
        output = binary.read_bytes().decode("latin-1", errors="ignore")
    match = re.search(r"^v(\d+\.\d+(?:\.\d+)*)$", output, re.MULTILINE)
    return "v" + match.group(1) if match else None


def normalize_lua(source: Path, target: Path) -> None:
    target.write_bytes(source.read_bytes().replace(b"\r\n", b"\n"))


def sync_assets(cfg: dict, d: dict[str, Path], *, force: bool = False) -> dict:
    """Copy upstream assets, regenerate every Flowseal strategy config."""
    upstream = d["upstream"]
    for folder in (
        d["assets"],
        d["assets"] / "lua",
        d["lists"],
        d["generated"],
        d["engine_lua"],
        d["engine_bin"],
    ):
        folder.mkdir(parents=True, exist_ok=True)

    copied_lists = 0
    for source in sorted((upstream / "lists").glob("*")):
        if not source.is_file() or source.name.endswith(".backup"):
            continue
        if source.name.endswith("-user.txt"):
            continue  # user lists are owned by the user, never replaced
        shutil.copy2(source, d["lists"] / source.name)
        copied_lists += 1

    for name, content in {
        "ipset-exclude-user.txt": "203.0.113.113/32\n",
        "list-general-user.txt": "# Never leave this file empty\ndomain.example.abc\n",
        "list-exclude-user.txt": "domain.example.abc\n",
    }.items():
        target = d["lists"] / name
        if not target.exists():
            target.write_text(content, encoding="utf-8")

    ipset_source = upstream / ".service" / "ipset-service.txt"
    if ipset_source.exists():
        ipset_target = d["lists"] / "ipset-all.txt"
        if ipset_target.exists():
            shutil.copy2(ipset_target, d["lists"] / "ipset-all.txt.backup")
        shutil.copy2(ipset_source, ipset_target)

    for source in sorted((upstream / "lua").glob("*.lua")):
        normalize_lua(source, d["engine_lua"] / source.name)
        normalize_lua(source, d["assets"] / "lua" / source.name)

    for source in sorted((upstream / "bin").glob("*.bin")):
        shutil.copy2(source, d["engine_bin"] / source.name)

    generated: dict[str, str] = {}
    warnings: list[str] = []
    for name in strategies(d):
        converted = build_args(cfg, d, name)
        value = render_config_value(converted.args)
        target = d["generated"] / f"{name}.conf"
        target.write_text(value + "\n", encoding="utf-8")
        generated[name] = hashlib.sha256(value.encode()).hexdigest()
        warnings.extend(f"{name}: {item}" for item in converted.warnings)

    return {
        "lists": copied_lists,
        "strategies": len(generated),
        "hashes": generated,
        "warnings": warnings,
        "version": (upstream / ".service" / "version.txt").read_text(encoding="utf-8").strip()
        if (upstream / ".service" / "version.txt").exists()
        else None,
    }


def managed_config_block(cfg: dict, d: dict[str, Path], args: list[str]) -> str:
    tcp, udp = firewall_ports(cfg)
    lines = [
        MANAGED_BEGIN,
        "# Generated by zapret-flowseal from Flowseal/zapret-discord-youtube.",
        "# Edit config.json, not this file.",
        f"ZAPRET_BASE={d['engine']}",
        "DESYNC_MARK=0x40000000",
        "DESYNC_MARK_POSTNAT=0x20000000",
        "NFQWS2_ENABLE=1",
        f"NFQWS2_PORTS_TCP={tcp}",
        f"NFQWS2_PORTS_UDP={udp}",
        "NFQWS2_TCP_PKT_OUT=20",
        "NFQWS2_TCP_PKT_IN=10",
        "NFQWS2_UDP_PKT_OUT=5",
        "NFQWS2_UDP_PKT_IN=3",
        "MODE_FILTER=none",
        "FLOWOFFLOAD=donttouch",
        "INIT_APPLY_FW=1",
        "DISABLE_IPV6=1",
        'NFQWS2_OPT="',
        *args,
        '"',
        MANAGED_END,
    ]
    return "\n".join(lines) + "\n"


def write_engine_config(cfg: dict, d: dict[str, Path]) -> str:
    path = d["engine"] / "config"
    if path.exists():
        text = path.read_text(encoding="utf-8")
    else:
        text = (d["engine"] / "config.default").read_text(encoding="utf-8")
    text = re.sub(
        re.escape(MANAGED_BEGIN) + r".*?" + re.escape(MANAGED_END) + r"\n?",
        "",
        text,
        flags=re.DOTALL,
    )
    converted = build_args(cfg, d)
    text = text.rstrip() + "\n\n" + managed_config_block(cfg, d, converted.args)
    path.write_text(text, encoding="utf-8")
    return hashlib.sha256(converted.args[0].encode()).hexdigest()


def is_running(d: dict[str, Path]) -> bool:
    try:
        pid = int(d["pidfile"].read_text().strip())
    except (OSError, ValueError):
        return False
    return Path(f"/proc/{pid}").exists()


def service_action(cfg: dict, action: str) -> None:
    d = assert_installed(cfg)
    if not d["init"].exists():
        raise CLIError(f"не найден init-скрипт: {d['init']}")
    action_ru = {"start": "запуск", "stop": "остановка", "restart": "перезапуск"}.get(action, action)
    log(f"zapret2 — {action_ru}")
    run([str(d["init"]), action])


def fetch_upstream(cfg: dict, d: dict[str, Path]) -> tuple[bool, str, str]:
    repo = d["upstream"]
    branch = cfg["upstream_branch"]
    git(repo, "fetch", "--quiet", "origin", branch)
    old = git(repo, "rev-parse", "HEAD").stdout.strip()
    new = git(repo, "rev-parse", "FETCH_HEAD").stdout.strip()
    if old != new:
        git(repo, "reset", "--hard", "--quiet", "FETCH_HEAD")
    return old != new, old, new


def upgrade_engine(cfg: dict, d: dict[str, Path], version: str) -> None:
    repo = d["engine"]
    log(f"обновляю движок zapret2 до {version}")
    git(repo, "fetch", "--quiet", "--depth", "1", "origin", f"refs/tags/{version}:refs/tags/{version}", check=False)
    git(repo, "checkout", "--quiet", "--detach", version)
    run(["make", "-C", str(repo)])


def install_units(cfg: dict) -> None:
    target = Path("/etc/systemd/system")
    target.mkdir(parents=True, exist_ok=True)
    for name, content in SYSTEMD_UNITS.items():
        path = target / name
        rendered = (
            content.replace("/opt/zapret2/flowseal", cfg["work_dir"])
            .replace("/opt/zapret2", cfg["engine_dir"])
        )
        path.write_text(rendered, encoding="utf-8")
        os.chmod(path, 0o644)
    if shutil.which("systemctl") and Path("/run/systemd/system").exists():
        run(["systemctl", "daemon-reload"])
        log("юниты systemd установлены (таймер автообновления не включён)")


def copy_tool(cfg: dict, d: dict[str, Path]) -> None:
    source = Path(__file__).resolve().parent
    d["tool"].mkdir(parents=True, exist_ok=True)
    for name in ("zapret-flowseal", "flowseal_convert.py"):
        shutil.copy2(source / name, d["tool"] / name)
        os.chmod(d["tool"] / name, 0o755)
    shutil.copy2(source / "zapret", d["tool"] / "zapret")
    os.chmod(d["tool"] / "zapret", 0o755)
    for name in ("zapret", "zapret-flowseal"):
        link = Path("/usr/local/bin") / name
        if link.is_symlink() or link.exists():
            link.unlink()
        link.symlink_to(d["tool"] / name)


def cmd_install(args: argparse.Namespace, cfg: dict) -> None:
    require_root()
    d = dirs(cfg)
    for binary in ("git", "make", "gcc", "nft", "curl"):
        if not shutil.which(binary):
            raise CLIError(f"не найдена зависимость: {binary}")

    # Рабочий каталог лежит ВНУТРИ engine_dir, поэтому его нельзя создавать
    # до клонирования zapret2. При первом запуске клонируем upstream во
    # временный каталог; при повторном — обновляем уже существующий репозиторий.
    upstream = d["upstream"]
    tmp_root: Path | None = None
    if (upstream / ".git").exists():
        fetch_upstream(cfg, d)
    else:
        if upstream.exists():
            move_aside_if_foreign(upstream)
        tmp_root = Path(tempfile.mkdtemp(prefix="zapret-flowseal-"))
        upstream = tmp_root / "upstream"
        log("клонирую репозиторий Flowseal")
        run([
            "git", "clone", "--depth", "1", "--branch", cfg["upstream_branch"],
            cfg["upstream_repo"], str(upstream),
        ])
    detected = detect_engine_version(upstream)

    version = cfg["engine_version"]
    if version == "auto":
        version = detected or "v1.0.7"
    if detected and detected != version:
        log(f"ВНИМАНИЕ: бинарник Flowseal — {detected}, выбран движок {version}")
    cfg["engine_version"] = version

    # Сохраняем пользовательские списки перед возможной заменой каталога.
    user_lists: dict[str, bytes] = {}
    old_lists = d["lists"]
    if old_lists.exists():
        for path in old_lists.glob("*-user.txt"):
            user_lists[path.name] = path.read_bytes()

    engine = d["engine"]
    move_aside_if_foreign(engine)
    engine.parent.mkdir(parents=True, exist_ok=True)

    if not (engine / ".git").exists():
        log(f"клонирую zapret2 {version}")
        run(["git", "clone", "--depth", "1", "--branch", version, cfg["engine_repo"], str(engine)])
    else:
        current = git(engine, "describe", "--tags", "--exact-match", check=False).stdout.strip()
        if current != version:
            upgrade_engine(cfg, d, version)
        else:
            log(f"движок zapret2 уже на {version}")

    work = d["work"]
    work.mkdir(parents=True, exist_ok=True)
    if upstream != d["upstream"]:
        if d["upstream"].exists():
            shutil.rmtree(d["upstream"])
        shutil.move(str(upstream), str(d["upstream"]))
    if tmp_root is not None:
        shutil.rmtree(tmp_root, ignore_errors=True)

    if user_lists:
        new_lists = d["lists"]
        new_lists.mkdir(parents=True, exist_ok=True)
        for name, data in user_lists.items():
            (new_lists / name).write_bytes(data)
        log(f"сохранено пользовательских списков: {len(user_lists)}")

    build_marker = engine / "nfq2" / "nfqws2"
    if not build_marker.exists():
        log("собираю nfqws2")
        run(["make", "-C", str(d["engine"])])
    if args.strategy:
        cfg["strategy"] = args.strategy
    save_config(cfg)

    log("синхронизирую файлы Flowseal и генерирую стратегии")
    result = sync_assets(cfg, d, force=True)
    state = load_state(cfg)
    state.update(
        {
            "upstream_commit": git(d["upstream"], "rev-parse", "HEAD").stdout.strip(),
            "flowseal_version": result["version"],
            "engine_version": version,
            "strategy_hashes": result["hashes"],
            "last_sync": datetime.now(timezone.utc).isoformat(),
        }
    )
    save_state(cfg, state)
    write_engine_config(cfg, d)
    install_units(cfg)
    copy_tool(cfg, d)

    log(f"установлено стратегий: {result['strategies']}, движок {version}")
    log(f"активная стратегия: {cfg['strategy']}")
    log("дальше: zapret — интерактивное меню, либо zapret list / zapret best --apply --start")


def cmd_update(args: argparse.Namespace, cfg: dict) -> None:
    require_root()
    d = assert_installed(cfg)
    handle = lock(cfg)
    try:
        changed, old, new = fetch_upstream(cfg, d)
        if not changed and not args.force:
            log(f"изменений в upstream нет ({new[:12]})")
            return

        log(f"upstream обновлён: {old[:12]} → {new[:12]}")
        if args.engine or cfg.get("auto_engine_update"):
            detected = detect_engine_version(d["upstream"])
            if detected and detected != cfg["engine_version"]:
                upgrade_engine(cfg, d, detected)
                cfg["engine_version"] = detected
                save_config(cfg)

        state = load_state(cfg)
        previous_hashes = state.get("strategy_hashes", {})
        result = sync_assets(cfg, d, force=args.force)
        active_changed = previous_hashes.get(cfg["strategy"]) != result["hashes"].get(cfg["strategy"])
        write_engine_config(cfg, d)
        if result["warnings"]:
            log(f"замечаний конвертации: {len(result['warnings'])} (Windows-опции / дубли lua-init)")
            for warning in result["warnings"][:5]:
                log(f"  заметка: {warning}")

        detected = detect_engine_version(d["upstream"])
        if detected and detected != cfg["engine_version"]:
            log(f"ВНИМАНИЕ: Flowseal использует движок {detected}, установлен {cfg['engine_version']}. Выполните: zapret update --engine")

        state.update(
            {
                "upstream_commit": new,
                "flowseal_version": result["version"],
                "engine_version": cfg["engine_version"],
                "strategy_hashes": result["hashes"],
                "last_sync": datetime.now(timezone.utc).isoformat(),
                "last_active_config_sha256": result["hashes"].get(cfg["strategy"]),
            }
        )
        save_state(cfg, state)

        if active_changed and cfg.get("auto_restart") and is_running(d):
            log("активная стратегия изменилась — перезапускаю")
            service_action(cfg, "restart")
        elif active_changed:
