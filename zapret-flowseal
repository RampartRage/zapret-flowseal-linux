# Interactive console, autostart, diagnostics and automatic strategy testing
# ---------------------------------------------------------------------------

URL_VARIANTS = (
    ("HTTP", ["--http1.1"]),
    ("TLS1.2", ["--tlsv1.2", "--tls-max", "1.2"]),
    ("TLS1.3", ["--tlsv1.3", "--tls-max", "1.3"]),
)


def parse_targets(path: Path) -> list[dict[str, str]]:
    """Parse Flowseal utils/targets.txt (Key = "URL" or "PING:ip")."""
    targets: list[dict[str, str]] = []
    if not path.exists():
        return targets
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = re.match(r'^\s*(\w+)\s*=\s*"([^"]+)"', line)
        if not match:
            continue
        name, value = match.group(1), match.group(2)
        if value.upper().startswith("PING:"):
            targets.append({"name": name, "kind": "ping", "value": value.split(":", 1)[1]})
        else:
            targets.append({"name": name, "kind": "url", "value": value})
    return targets


def probe_url(url: str, flags: list[str], timeout: int) -> str:
    command = [
        "curl", "-I", "-sS", "-m", str(timeout), "--connect-timeout", "2",
        "-o", os.devnull, "-w", "%{http_code}", *flags, url,
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout + 2)
    except (OSError, subprocess.TimeoutExpired):
        return "ERROR"
    stderr = result.stderr.lower()
    if any(word in stderr for word in ("certificate", "could not resolve host", "ssl connect", "handshake")):
        return "SSL"
    code = result.stdout.strip()
    return "OK" if result.returncode == 0 and code.isdigit() and code != "000" else "ERROR"


def probe_ping(host: str) -> bool:
    try:
        result = subprocess.run(
            ["ping", "-c", "1", "-W", "1", host],
            capture_output=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def test_strategy(targets: list[dict[str, str]], timeout: int, workers: int) -> dict:
    jobs: list[tuple[str, str, object]] = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for target in targets:
            if target["kind"] == "url":
                for label, flags in URL_VARIANTS:
                    jobs.append((target["name"], label, pool.submit(probe_url, target["value"], flags, timeout)))
            else:
                jobs.append((target["name"], "PING", pool.submit(probe_ping, target["value"])))

        tokens: dict[str, list[str]] = {}
        for name, label, future in jobs:
            try:
                value = future.result()
            except Exception:
                value = False if label == "PING" else "ERROR"
            if label == "PING":
                token = f"PING:{'OK' if value else '--'}"
            else:
                token = f"{label}:{value}"
            tokens.setdefault(name, []).append(token)

    flat = [token for values in tokens.values() for token in values]
    return {
        "ok": sum(1 for token in flat if token.endswith(":OK")),
        "ping_ok": sum(1 for token in flat if token == "PING:OK"),
        "errors": sum(1 for token in flat if token.endswith((":ERROR", ":SSL"))),
        "tokens": tokens,
    }


def cmd_best(args: argparse.Namespace, cfg: dict) -> None:
    require_root()
    d = assert_installed(cfg)
    targets = parse_targets(d["upstream"] / "utils" / "targets.txt")
    if not targets:
        raise CLIError("utils/targets.txt not found in upstream")
    original = cfg["strategy"]
    was_running = is_running(d)
    results: list[dict] = []
    timeout = max(1, args.timeout)

    names = strategies(d)
    if args.limit:
        names = names[: max(1, args.limit)]
    print(paint(f"\nTesting {len(names)} Flowseal strategies "
                f"({len(targets)} targets, timeout {timeout}s)\n", "bold"))
    try:
        for name in names:
            print(paint(f"[{name}]", "cyan"), end=" ", flush=True)
            try:
                service_action(cfg, "stop")
                cfg["strategy"] = name
                write_engine_config(cfg, d)
                service_action(cfg, "start")
                if not wait_for_daemon(d, 4):
                    print(paint("failed to start", "red"))
                    results.append({"name": name, "ok": -1, "ping_ok": -1, "errors": 0, "tokens": {}})
                    continue
                result = test_strategy(targets, timeout, args.workers)
                result["name"] = name
                results.append(result)
                color = "green" if result["ok"] > 0 else "red"
                print(paint(f"OK={result['ok']:2d}  ping={result['ping_ok']:2d}  err={result['errors']:2d}", color))
            except CLIError as exc:
                print(paint(f"error: {exc}", "red"))
                results.append({"name": name, "ok": -1, "ping_ok": -1, "errors": 0, "tokens": {}})
    finally:
        try:
            service_action(cfg, "stop")
        except CLIError:
            pass
        cfg["strategy"] = original
        save_config(cfg)
        write_engine_config(cfg, d)

    ranked = sorted(results, key=lambda item: (item["ok"], item["ping_ok"]), reverse=True)
    if not ranked:
        raise CLIError("no strategy produced results")
    best = ranked[0]
    print()
    print(paint("=== RESULTS ===", "bold"))
    for item in ranked:
        mark = paint("*", "green") if item is best else " "
        print(f" {mark} {item['name']:<38} OK={item['ok']:3d}  ping={item['ping_ok']:2d}")

    report_dir = d["work"] / "test-results"
    report_dir.mkdir(parents=True, exist_ok=True)
    report = report_dir / f"{datetime.now().strftime('%Y-%m-%d_%H-%M-%S')}.txt"
    lines = [f"best: {best['name']} (OK={best['ok']}, ping={best['ping_ok']})", ""]
    for item in ranked:
        lines.append(f"{item['name']}: OK={item['ok']} ping={item['ping_ok']} errors={item['errors']}")
        for name, tokens in item["tokens"].items():
            lines.append(f"  {name}: {' '.join(tokens)}")
        lines.append("")
    report.write_text("\n".join(lines), encoding="utf-8")

    print(paint(f"\nBest strategy: {best['name']}", "green"))
    print(f"Report: {report}")
    if args.apply and best["ok"] > 0:
        cfg["strategy"] = best["name"]
        save_config(cfg)
        write_engine_config(cfg, d)
        log(f"applied: {best['name']}")
        if was_running or args.start:
            service_action(cfg, "start")


def wait_for_daemon(d: dict[str, Path], seconds: int) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if is_running(d):
            return True
        time.sleep(0.2)
    return False


def cmd_autostart(args: argparse.Namespace, cfg: dict) -> None:
    require_root()
    unit = "zapret-flowseal.service"
    if not Path(f"/etc/systemd/system/{unit}").exists():
        raise CLIError("systemd unit missing. Run install first")
    if args.action == "status":
        result = run(["systemctl", "is-enabled", unit], capture=True, check=False)
        state = result.stdout.strip() or "unknown"
        print(f"autostart: {paint(state, 'green' if state == 'enabled' else 'yellow')}")
        return
    if args.action == "on":
        run(["systemctl", "enable", "--now", unit])
        log("autostart enabled, zapret started")
    else:
        run(["systemctl", "disable", "--now", unit])
        log("autostart disabled, zapret stopped")


def cmd_diagnostics(args: argparse.Namespace, cfg: dict) -> None:
    d = dirs(cfg)
    checks: list[tuple[str, bool, str]] = []

    def check(label: str, ok: bool, hint: str = "") -> None:
        checks.append((label, ok, hint))

    check("CLI config", config_path(cfg).exists(), "run install")
    check("Flowseal upstream", (d["upstream"] / "general.bat").exists(), "run install")
    check("zapret2 init script", d["init"].exists(), "run install")
    check("nfqws2 binary", (d["engine"] / "nfq2" / "nfqws2").exists(), "run install")
    check("engine config", (d["engine"] / "config").exists(), "run install")
    check("blobs.lua", (d["engine_lua"] / "blobs.lua").exists(), "run update")
    check("fake payloads", len(list(d["engine_bin"].glob("*.bin"))) >= 20, "run update")
    check("generated strategies", len(list(d["generated"].glob("*.conf"))) >= 20, "run update")
    check("active strategy", (d["upstream"] / f"{cfg['strategy']}.bat").exists(), "choose another strategy")
    check("curl", shutil.which("curl") is not None, "install curl")
    check("ping", shutil.which("ping") is not None, "install iputils-ping")
    check("daemon running", is_running(d), "run: zapret start")
    if os.geteuid() == 0:
        table = run(["nft", "list", "table", "inet", "zapret2"], capture=True, check=False)
        check("nftables table", table.returncode == 0, "run: zapret start")

    print(paint("\n=== DIAGNOSTICS ===", "bold"))
    for label, ok, hint in checks:
        status = paint("OK", "green") if ok else paint("FAIL", "red")
        suffix = f" ({hint})" if hint and not ok else ""
        print(f"  [{status}] {label}{suffix}")
    print()


def invoke(argv: list[str], *, need_root: bool = True) -> int:
    """Run another CLI command from the menu, escalating with sudo if needed."""
    if need_root and os.geteuid() != 0:
        return subprocess.run(["sudo", str(Path(__file__).resolve()), *argv]).returncode
    try:
        args = build_parser().parse_args(argv)
        cfg = load_config()
        args.func(args, cfg)
        return 0
    except CLIError as exc:
        print(paint(f"error: {exc}", "red"), file=sys.stderr)
        return 1


def cmd_menu(args: argparse.Namespace, cfg: dict) -> None:
    while True:
        d = dirs(cfg)
        clear_screen()
        state = load_state(cfg)
        running = is_running(d)
        enabled = "unknown"
        autoupdate = "unknown"
        if Path("/run/systemd/system").exists():
            enabled = run(["systemctl", "is-enabled", "zapret-flowseal.service"], capture=True, check=False).stdout.strip() or "unknown"
            autoupdate = run(["systemctl", "is-active", "zapret-flowseal-update.timer"], capture=True, check=False).stdout.strip() or "unknown"

        print(paint("  ZAPRET FLOWSEAL MANAGER  v1.0", "bold"))
        print(paint("  " + "-" * 48, "gray"))
        print(f"  Strategy      : {paint(cfg['strategy'], 'cyan')}")
        print(f"  Service       : {paint('running' if running else 'stopped', 'green' if running else 'yellow')}")
        print(f"  Autostart     : {paint(enabled, 'green' if enabled == 'enabled' else 'yellow')}")
        print(f"  Auto-update   : {paint(autoupdate, 'green' if autoupdate == 'active' else 'yellow')}")
        print(f"  Game filter   : {cfg['game_filter']}")
        print(f"  Flowseal      : v{state.get('flowseal_version', '?')} ({state.get('upstream_commit', '?')[:8]})")
        print()
        print(paint("  :: SERVICE", "bold"))
        print("     1. Install / reinstall")
        print("     2. Install service (autostart ON)")
        print("     3. Remove service (autostart OFF)")
        print("     4. Check status")
        print(paint("  :: STRATEGY", "bold"))
        print("     5. Select strategy")
        print("     6. Find best strategy (auto test)")
        print("     7. Game filter")
        print(paint("  :: UPDATES", "bold"))
        print("     8. Update configs now")
        print("     9. Auto-update check (on/off)")
        print("    10. Update engine")
        print(paint("  :: TOOLS", "bold"))
        print("    11. Diagnostics")
        print("    12. Dry-run check")
        print()
        print(paint("     0. Exit", "gray"))
        print()

        choice = input("  Select option: ").strip()
        if choice == "0":
            return
        if choice == "1":
            invoke(["install"], need_root=True)
        elif choice == "2":
            if not is_installed(cfg):
                invoke(["install"], need_root=True)
            invoke(["autostart", "on"], need_root=True)
        elif choice == "3":
            invoke(["autostart", "off"], need_root=True)
        elif choice == "4":
            invoke(["status"], need_root=False)
        elif choice == "5":
            if not is_installed(cfg):
                print(paint("  Not installed. Choose option 1 first.", "red"))
            else:
                names = strategies(d)
                for index, name in enumerate(names, 1):
                    marker = "*" if name == cfg["strategy"] else " "
                    print(f"  {marker} {index:2d}. {name}")
                value = input("  Strategy number or name: ").strip()
                if value:
                    invoke(["use", value], need_root=True)
        elif choice == "6":
            if not is_installed(cfg):
                print(paint("  Not installed. Choose option 1 first.", "red"))
                input(paint("\n  Press Enter to continue...", "gray"))
                continue
            apply_best = input("  Apply the best strategy automatically? [y/N]: ").strip().lower() in ("y", "yes")
            argv = ["best", "--apply"] if apply_best else ["best"]
            invoke(argv, need_root=True)
        elif choice == "7":
            print("  1. off   2. all   3. tcp   4. udp")
            mode = {"1": "off", "2": "all", "3": "tcp", "4": "udp"}.get(input("  Mode: ").strip())
            if mode:
                invoke(["game-filter", mode], need_root=True)
        elif choice == "8":
            invoke(["update"], need_root=True)
        elif choice == "9":
            current = "unknown"
            if Path("/run/systemd/system").exists():
                current = run(["systemctl", "is-active", "zapret-flowseal-update.timer"], capture=True, check=False).stdout.strip()
            action = "off" if current == "active" else "on"
            invoke(["auto-update", action], need_root=True)
        elif choice == "10":
            invoke(["update", "--engine"], need_root=True)
        elif choice == "11":
            invoke(["diagnostics"], need_root=False)
        elif choice == "12":
            invoke(["check"], need_root=False)
        else:
            print(paint("  Unknown option", "yellow"))
        input(paint("\n  Press Enter to continue...", "gray"))


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=APP, description="Flowseal zapret strategies on Linux")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("install", help="install engine, assets, configs and systemd units")
    p.add_argument("--strategy", help="strategy to activate")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("list", help="list strategies from Flowseal repository")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("use", help="select a strategy by name or number")
    p.add_argument("strategy")
    p.set_defaults(func=cmd_use)

    for action in ("start", "stop", "restart"):
        p = sub.add_parser(action, help=f"{action} zapret")
        p.set_defaults(func=cmd_service, action=action)

    p = sub.add_parser("status", help="show current state")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("update", help="sync configs with upstream")
    p.add_argument("--force", action="store_true")
    p.add_argument("--engine", action="store_true", help="upgrade zapret2 if Flowseal bumped its version")
    p.add_argument("--auto", action="store_true", help="quiet mode for the systemd timer")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("game-filter", help="toggle game traffic handling")
    p.add_argument("mode", choices=["off", "tcp", "udp", "all"])
    p.add_argument("--tcp", default="1024-65535")
    p.add_argument("--udp", default="1024-65535")
    p.set_defaults(func=cmd_game_filter)

    p = sub.add_parser("auto-update", help="manage the update timer")
    p.add_argument("action", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_auto_update)

    p = sub.add_parser("check", help="validate every converted strategy")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("watch", help="poll upstream without systemd")
    p.add_argument("--interval", type=int, default=3600)
    p.set_defaults(func=cmd_watch)

    p = sub.add_parser("uninstall", help="remove units and optionally all data")
    p.add_argument("--purge", action="store_true")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("menu", help="interactive console manager (default)")
    p.set_defaults(func=cmd_menu)

    p = sub.add_parser("best", help="test all Flowseal strategies and pick the best")
    p.add_argument("--apply", action="store_true", help="activate the winning strategy")
    p.add_argument("--start", action="store_true", help="start zapret after applying")
    p.add_argument("--limit", type=int, help="test only the first N strategies")
    p.add_argument("--timeout", type=int, default=5, help="per-request timeout in seconds")
    p.add_argument("--workers", type=int, default=12, help="parallel checks")
    p.set_defaults(func=cmd_best)

    p = sub.add_parser("autostart", help="enable/disable start on boot")
    p.add_argument("action", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_autostart)

    p = sub.add_parser("diagnostics", help="check installation health")
    p.set_defaults(func=cmd_diagnostics)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command is None:
        args = argparse.Namespace(command="menu", func=cmd_menu)
    try:
        cfg = load_config()
        args.func(args, cfg)
    except CLIError as exc:
        print(paint(f"error: {exc}", "red"), file=sys.stderr)
        return 1
    except EOFError:
        print()
        return 0
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
