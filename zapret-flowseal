URL_VARIANTS = (
    ("HTTP", ["--http1.1"]),
    ("TLS1.2", ["--tlsv1.2", "--tls-max", "1.2"]),
    ("TLS1.3", ["--tlsv1.3", "--tls-max", "1.3"]),
)


def parse_targets(path: Path) -> list[dict[str, str]]:
    """Parse Flowseal utils/targets.txt (Key = "URL" or "PING:ip")."""
    targets: list[dict[str, str]] = []
    if not path.exists():
        return targets
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = re.match(r'^\s*(\w+)\s*=\s*"([^"]+)"', line)
        if not match:
            continue
        name, value = match.group(1), match.group(2)
        if value.upper().startswith("PING:"):
            targets.append({"name": name, "kind": "ping", "value": value.split(":", 1)[1]})
        else:
            targets.append({"name": name, "kind": "url", "value": value})
    return targets


def probe_url(url: str, flags: list[str], timeout: int) -> str:
    command = [
        "curl", "-I", "-sS", "-m", str(timeout), "--connect-timeout", "2",
        "-o", os.devnull, "-w", "%{http_code}", *flags, url,
    ]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=timeout + 2)
    except (OSError, subprocess.TimeoutExpired):
        return "ERROR"
    stderr = result.stderr.lower()
    if any(word in stderr for word in ("certificate", "could not resolve host", "ssl connect", "handshake")):
        return "SSL"
    code = result.stdout.strip()
    return "OK" if result.returncode == 0 and code.isdigit() and code != "000" else "ERROR"


def probe_ping(host: str) -> bool:
    try:
        result = subprocess.run(
            ["ping", "-c", "1", "-W", "1", host],
            capture_output=True,
            timeout=3,
        )
    except (OSError, subprocess.TimeoutExpired):
        return False
    return result.returncode == 0


def test_strategy(targets: list[dict[str, str]], timeout: int, workers: int) -> dict:
    jobs: list[tuple[str, str, object]] = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for target in targets:
            if target["kind"] == "url":
                for label, flags in URL_VARIANTS:
                    jobs.append((target["name"], label, pool.submit(probe_url, target["value"], flags, timeout)))
            else:
                jobs.append((target["name"], "PING", pool.submit(probe_ping, target["value"])))

        tokens: dict[str, list[str]] = {}
        for name, label, future in jobs:
            try:
                value = future.result()
            except Exception:
                value = False if label == "PING" else "ERROR"
            if label == "PING":
                token = f"PING:{'OK' if value else '--'}"
            else:
                token = f"{label}:{value}"
            tokens.setdefault(name, []).append(token)

    flat = [token for values in tokens.values() for token in values]
    return {
        "ok": sum(1 for token in flat if token.endswith(":OK")),
        "ping_ok": sum(1 for token in flat if token == "PING:OK"),
        "errors": sum(1 for token in flat if token.endswith((":ERROR", ":SSL"))),
        "tokens": tokens,
    }


def cmd_best(args: argparse.Namespace, cfg: dict) -> None:
    require_root()
    d = assert_installed(cfg)
    targets = parse_targets(d["upstream"] / "utils" / "targets.txt")
    if not targets:
        raise CLIError("utils/targets.txt не найден в upstream")
    original = cfg["strategy"]
    was_running = is_running(d)
    results: list[dict] = []
    timeout = max(1, args.timeout)

    names = strategies(d)
    if args.limit:
        names = names[: max(1, args.limit)]
    print(paint(f"\nТестирую {len(names)} стратегий Flowseal "
                f"({len(targets)} целей, таймаут {timeout} с)\n", "bold"))
    try:
        for name in names:
            print(paint(f"[{name}]", "cyan"), end=" ", flush=True)
            try:
                service_action(cfg, "stop")
                cfg["strategy"] = name
                write_engine_config(cfg, d)
                service_action(cfg, "start")
                if not wait_for_daemon(d, 4):
                    print(paint("не удалось запустить", "red"))
                    results.append({"name": name, "ok": -1, "ping_ok": -1, "errors": 0, "tokens": {}})
                    continue
                result = test_strategy(targets, timeout, args.workers)
                result["name"] = name
                results.append(result)
                color = "green" if result["ok"] > 0 else "red"
                print(paint(f"успех={result['ok']:2d}  пинг={result['ping_ok']:2d}  ошиб={result['errors']:2d}", color))
            except CLIError as exc:
                print(paint(f"ошибка: {exc}", "red"))
                results.append({"name": name, "ok": -1, "ping_ok": -1, "errors": 0, "tokens": {}})
    finally:
        try:
            service_action(cfg, "stop")
        except CLIError:
            pass
        cfg["strategy"] = original
        save_config(cfg)
        write_engine_config(cfg, d)

    ranked = sorted(results, key=lambda item: (item["ok"], item["ping_ok"]), reverse=True)
    if not ranked:
        raise CLIError("ни одна стратегия не дала результатов")
    best = ranked[0]
    print()
    print(paint("=== РЕЗУЛЬТАТЫ ===", "bold"))
    for item in ranked:
        mark = paint("*", "green") if item is best else " "
        print(f" {mark} {item['name']:<38} успех={item['ok']:3d}  пинг={item['ping_ok']:2d}")

    report_dir = d["work"] / "test-results"
    report_dir.mkdir(parents=True, exist_ok=True)
    report = report_dir / f"{datetime.now().strftime('%Y-%m-%d_%H-%M-%S')}.txt"
    lines = [f"лучшая: {best['name']} (успех={best['ok']}, пинг={best['ping_ok']})", ""]
    for item in ranked:
        lines.append(f"{item['name']}: успех={item['ok']} пинг={item['ping_ok']} ошибки={item['errors']}")
        for name, tokens in item["tokens"].items():
            lines.append(f"  {name}: {' '.join(tokens)}")
        lines.append("")
    report.write_text("\n".join(lines), encoding="utf-8")

    print(paint(f"\nЛучшая стратегия: {best['name']}", "green"))
    print(f"Отчёт: {report}")
    if args.apply and best["ok"] > 0:
        cfg["strategy"] = best["name"]
        save_config(cfg)
        write_engine_config(cfg, d)
        log(f"применена: {best['name']}")
        if was_running or args.start:
            service_action(cfg, "start")


def wait_for_daemon(d: dict[str, Path], seconds: int) -> bool:
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        if is_running(d):
            return True
        time.sleep(0.2)
    return False


