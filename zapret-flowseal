        elif choice == "7":
            print(paint("  1 — выключено    2 — TCP + UDP    3 — TCP    4 — UDP", "cyan"))
            mode = {"1": "off", "2": "all", "3": "tcp", "4": "udp"}.get(input("  Режим: ").strip())
            if mode:
                invoke(["game-filter", mode], need_root=True)
        elif choice == "8":
            invoke(["update"], need_root=True)
        elif choice == "9":
            current = "unknown"
            if Path("/run/systemd/system").exists():
                current = run(["systemctl", "is-active", "zapret-flowseal-update.timer"], capture=True, check=False).stdout.strip()
            action = "off" if current == "active" else "on"
            invoke(["auto-update", action], need_root=True)
        elif choice == "10":
            invoke(["update", "--engine"], need_root=True)
        elif choice == "11":
            invoke(["diagnostics"], need_root=False)
        elif choice == "12":
            invoke(["check"], need_root=False)
        else:
            print(paint("  Неизвестный пункт меню", "yellow"))
        pause()


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog=APP, description="Стратегии Flowseal zapret на Linux")
    sub = parser.add_subparsers(dest="command")

    p = sub.add_parser("install", help="установить движок, файлы, конфиги и юниты systemd")
    p.add_argument("--strategy", help="strategy to activate")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("list", help="показать стратегии репозитория Flowseal")
    p.set_defaults(func=cmd_list)

    p = sub.add_parser("use", help="выбрать стратегию по имени или номеру")
    p.add_argument("strategy")
    p.set_defaults(func=cmd_use)

    for action in ("start", "stop", "restart"):
        p = sub.add_parser(action, help=f"{action} zapret")
        p.set_defaults(func=cmd_service, action=action)

    p = sub.add_parser("status", help="показать текущее состояние")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("update", help="синхронизировать конфиги с upstream")
    p.add_argument("--force", action="store_true")
    p.add_argument("--engine", action="store_true", help="обновить zapret2, если Flowseal изменил версию")
    p.add_argument("--auto", action="store_true", help="режим для systemd-таймера")
    p.set_defaults(func=cmd_update)

    p = sub.add_parser("game-filter", help="настроить обработку игрового трафика")
    p.add_argument("mode", choices=["off", "tcp", "udp", "all"])
    p.add_argument("--tcp", default="1024-65535")
    p.add_argument("--udp", default="1024-65535")
    p.set_defaults(func=cmd_game_filter)

    p = sub.add_parser("auto-update", help="управлять таймером обновления")
    p.add_argument("action", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_auto_update)

    p = sub.add_parser("check", help="проверить все сконвертированные стратегии")
    p.set_defaults(func=cmd_check)

    p = sub.add_parser("watch", help="опрашивать upstream без systemd")
    p.add_argument("--interval", type=int, default=3600)
    p.set_defaults(func=cmd_watch)

    p = sub.add_parser("uninstall", help="удалить юниты и, опционально, все данные")
    p.add_argument("--purge", action="store_true")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("menu", help="интерактивный консольный менеджер (по умолчанию)")
    p.set_defaults(func=cmd_menu)

    p = sub.add_parser("best", help="протестировать все стратегии Flowseal и выбрать лучшую")
    p.add_argument("--apply", action="store_true", help="применить лучшую стратегию")
    p.add_argument("--start", action="store_true", help="запустить zapret после применения")
    p.add_argument("--limit", type=int, help="тестировать только первые N стратегий")
    p.add_argument("--timeout", type=int, default=5, help="таймаут одного запроса в секундах")
    p.add_argument("--workers", type=int, default=12, help="количество параллельных проверок")
    p.set_defaults(func=cmd_best)

    p = sub.add_parser("autostart", help="включить/выключить запуск при загрузке")
    p.add_argument("action", choices=["on", "off", "status"])
    p.set_defaults(func=cmd_autostart)

    p = sub.add_parser("diagnostics", help="проверить исправность установки")
    p.set_defaults(func=cmd_diagnostics)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    if args.command is None:
        args = argparse.Namespace(command="menu", func=cmd_menu)
    try:
        cfg = load_config()
        args.func(args, cfg)
    except CLIError as exc:
        print(paint(f"ошибка: {exc}", "red"), file=sys.stderr)
        return 1
    except EOFError:
        print()
        return 0
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
