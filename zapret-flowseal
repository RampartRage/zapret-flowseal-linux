from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from flowseal_convert import ConvertedStrategy, convert_strategy, render_config_value  # noqa: E402

APP = "zapret-flowseal"
DEFAULT_CONFIG = {
    "upstream_repo": "https://github.com/Flowseal/zapret-discord-youtube.git",
    "upstream_branch": "main",
    "engine_repo": "https://github.com/bol-van/zapret2.git",
    "engine_version": "auto",
    "engine_dir": "/opt/zapret2",
    "work_dir": "/opt/zapret2/flowseal",
    "config_dir": "/etc/zapret-flowseal",
    "strategy": "general (FAKE TLS AUTO)",
    "game_filter": "off",
    "game_filter_tcp": "1024-65535",
    "game_filter_udp": "1024-65535",
    "auto_restart": True,
    "auto_engine_update": False,
}
MANAGED_BEGIN = "# >>> zapret-flowseal managed settings"
MANAGED_END = "# <<< zapret-flowseal managed settings"
BASE_TCP_PORTS = "80,443,2053,2083,2087,2096,8443"
BASE_UDP_PORTS = "443,19294-19344,50000-50100"

SYSTEMD_UNITS = {
