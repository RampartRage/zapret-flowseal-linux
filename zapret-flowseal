#!/usr/bin/env python3
"""Console adapter for Flowseal zapret strategies on Linux (zapret2/nfqws2).

Uses only strategies from https://github.com/Flowseal/zapret-discord-youtube.
Keeps them in sync with upstream and can reload a running strategy on update.
"""

